{
  "name": "ws-reviewer",
  "version": "0.1.0",
  "description": "Explore staged, unstaged and recent-commit diffs across a workspace of git repos in the browser.",
  "type": "module",
  "bin": {
    "ws-reviewer": "bin/ws-reviewer.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node bin/ws-reviewer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
